# Copy this to .env; add real secrets locally. NEVER commit a populated .env file.
AZURE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_API_KEY=YOUR_AZURE_KEY
OPENAI_API_KEY=YOUR_OPENAI_KEY
# Optional; needed for the supplier_validation endpoint and supplier_info prediction.
OPENAI_SUPPLIER_MODEL=
# Strongly recommended before exposing the API on a public network.
INVOICE_API_KEY=
