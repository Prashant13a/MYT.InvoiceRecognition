<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>MYT.InvoiceRecognition.Net8.Local</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Using Include="Microsoft.Extensions.Logging" />
    <!-- Share the Azure implementation without referencing the API or OpenAI services. -->
    <Compile Include="../MYT.InvoiceRecognition.Api/Services/AzureDocumentService.cs" Link="Services/AzureDocumentService.cs" />
    <Compile Include="../MYT.InvoiceRecognition.Api/Options/AzureDocumentIntelligenceOptions.cs" Link="Options/AzureDocumentIntelligenceOptions.cs" />
    <Compile Include="../MYT.InvoiceRecognition.Api/Models/ApiModels.cs" Link="Models/ApiModels.cs" />
    <Compile Include="../MYT.InvoiceRecognition.Api/Utilities/InvoiceUtilities.cs" Link="Utilities/InvoiceUtilities.cs" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
